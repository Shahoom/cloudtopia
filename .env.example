# ── Database ────────────────────────────────────────────────────────────────
# Local dev: plain local Postgres (no SSL).
DATABASE_URL=postgres://127.0.0.1:5432/payload_db
#
# Production (Supabase) — pick the right endpoint per task:
#   • Runtime (app + /admin) → transaction pooler, port 6543:
#       postgres://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&sslmode=require
#   • Migrate / seed → DIRECT connection, port 5432:
#       postgres://USER:PASSWORD@HOST:5432/postgres?sslmode=require
# The pg pool adds ssl automatically for any non-localhost host.

PAYLOAD_SECRET=replace-with-a-long-random-secret-before-production

# ── AI / translation (optional) ─────────────────────────────────────────────
# Enables Payload auto-translation for English Pages, Projects, and Service FAQs.
# Without this key, saves still work, but AI translation is skipped.
# SECURITY: never commit a real key. If a key was ever committed to .env.local,
# rotate it in the OpenAI dashboard and replace it here. (.env.local is gitignored.)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TRANSLATION_MODEL=gpt-5.2

# AI chatbot fallback. The chatbot answers common questions from built-in flows
# (no API). When a question matches no flow it falls back to OpenAI by default.
# Set to "false" to make the chatbot 100% flow-driven and never call OpenAI —
# unmatched questions then get a guided menu + WhatsApp handoff instead.
NEXT_PUBLIC_AI_CHAT_FALLBACK=true

# ── Media storage — Supabase Storage (S3-compatible) ────────────────────────
# When ALL five are set, the s3Storage plugin (payload.config.ts) stores Media
# uploads in the bucket. When any is missing, Media falls back to local disk
# (public/uploads) — fine for dev, but NOT safe on Vercel (read-only FS).
# Create the bucket + an S3 access key in Supabase: Storage → S3 Connection.
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── Public site ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://cloudtopia.net
NEXT_PUBLIC_CLOUDTOPIA_TR_WHATSAPP=905011511116
NEXT_PUBLIC_CLOUDTOPIA_OMAN_WHATSAPP=96895886393

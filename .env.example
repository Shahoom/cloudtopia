DATABASE_URL=postgres://127.0.0.1:5432/payload_db
PAYLOAD_SECRET=replace-with-a-long-random-secret-before-production

# Enables Payload auto-translation for English Pages, Projects, and Service FAQs.
# Without this key, saves still work, but AI translation is skipped.
OPENAI_API_KEY=
OPENAI_TRANSLATION_MODEL=gpt-5.2

# ========================
# CloudTopia — .gitignore
# ========================

# ---- Dependencies ----
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# ---- Next.js build output ----
/.next/
/out/
/build
/.vercel

# ---- Production ----
/dist

# ---- Environment files (NEVER commit secrets) ----
.env
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local
.env*.local

# ---- Credentials & certificates ----
*.pem
*.key
*.crt
*.cert
*.p12
*.pfx
service-account*.json
*-credentials.json
*-keyfile.json
gcp-key*.json
firebase-adminsdk*.json
secrets.json
secrets.yaml
secrets.yml

# ---- Debug logs ----
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
lerna-debug.log*

# ---- OS-generated files ----
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ---- Editor & IDE ----
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ---- TypeScript ----
*.tsbuildinfo
next-env.d.ts

# ---- Testing / Coverage ----
/coverage
/.nyc_output

# ---- Misc ----
.cache
*.log
*.tmp
*.bak
*.swp

# ---- Scratch / stray build artifacts (never commit) ----
/cloudtopia/
/scratch/
/blog-posts/
/.worktrees/
.vercel
scratchpad/
